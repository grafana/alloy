logging {
  level = "debug"
}

livedebugging {
  enabled = true
}

loki.relabel "kafka" {
  forward_to = []

  rule {
    source_labels = ["__meta_kafka_topic"]
    target_label  = "topic"
  }
}

loki.source.kafka "kafka" {
  brokers       = ["kafka:9092"]
  topics        = ["test1", "test2", "test3"]
  forward_to    = [loki.process.test.receiver]
  relabel_rules = loki.relabel.kafka.rules
}

loki.process "test" {
  forward_to = [loki.relabel.test.receiver]

  stage.static_labels {
    values = {
      alloy_test_name = "loki-source-kafka",
    }
  }
}

loki.relabel "test" {
  forward_to = [loki.write.loki.receiver]

  rule {
    source_labels = ["topic"]
    target_label  = "service_name"
  }
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
