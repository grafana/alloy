// Instruments the java-app JVM in this test's namespace. Beyla also attaches
// its Java agent to the JVM, which reports the JVM runtime metrics.
beyla.ebpf "default" {
  discovery {
    instrument {
      open_ports = "8080"
      exe_path   = "*java"

      kubernetes {
        namespace = "test-beyla-java"
      }
    }
  }

  attributes {
    kubernetes {
      enable = "true"
    }
  }

  metrics {
    features = ["application", "application_runtime"]
  }

  jvm_runtime_metrics {
    sampling_interval = "1s"
  }

  output {
    traces = [otelcol.connector.spanmetrics.default.input]
  }
}

prometheus.scrape "beyla" {
  targets         = beyla.ebpf.default.targets
  honor_labels    = true
  scrape_interval = "1s"
  scrape_timeout  = "500ms"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// Turns Beyla's spans into metrics, so Mimir can show that spans for the
// instrumented service were produced.
otelcol.connector.spanmetrics "default" {
  dimension {
    name = "telemetry.sdk.language"
  }

  histogram {
    explicit {}
  }

  metrics_flush_interval = "1s"

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
  }
}

otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }

  external_labels = {
    alloy_test_name = "beyla-java",
  }
}
