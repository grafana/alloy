# syntax=docker/dockerfile:1
# Layers Oracle Instant Client (ZIP) on the distroless Alloy image (Dockerfile.chisel at the repo root).
# The distroless image has no shell, package manager or ldconfig, so everything is prepared in an Ubuntu
# stage and copied over. The only runtime dependencies of the client that the image lacks are libaio and libgcc_s.
# Matches Oracle's ZIP install flow:
# https://www.oracle.com/database/technologies/instant-client/linux-x86-64-downloads.html
#
# Layered on alloy-integration-tests. Built via tests/oracledb/test.yaml (alloy_container.dockerfile).
#   make ALLOY_IMAGE_DISTROLESS=alloy-integration-tests alloy-image-distroless
#   docker build --platform=linux/amd64 -f integration-tests/docker/tests/oracledb/Dockerfile.alloy -t alloy-integration-tests-oracledb:latest .

FROM --platform=linux/amd64 ubuntu:noble@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac AS oracle-client

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates wget unzip libaio1t64 \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /opt/oracle

# Basic package is required; override with --build-arg ORACLE_IC_ZIP_URL=... if Oracle moves the artifact.
ARG ORACLE_IC_ZIP_URL=https://download.oracle.com/otn_software/linux/instantclient/2326100/instantclient-basic-linux.x64-23.26.1.0.0.zip

RUN wget -q --progress=dot:giga --no-check-certificate \
		--header "Cookie: oraclelicense=accept-securebackup-cookie" \
		-O /tmp/instantclient-basic.zip \
		"${ORACLE_IC_ZIP_URL}" \
	&& unzip -q /tmp/instantclient-basic.zip -d /opt/oracle \
	&& rm -f /tmp/instantclient-basic.zip \
	&& ln -s "$(ls -d /opt/oracle/instantclient_* | head -1)" /opt/oracle/instantclient \
	&& mkdir -p /opt/oracle/instantclient/network/admin \
	&& chmod -R a+rX /opt/oracle

FROM --platform=linux/amd64 alloy-integration-tests:latest

# Instant Client links against libaio.so.1 (Ubuntu noble ships it as libaio.so.1t64) and dlopen()s libgcc_s.so.1;
# without the latter it segfaults on the first connection.
COPY --from=oracle-client /usr/lib/x86_64-linux-gnu/libgcc_s.so.1 /usr/lib/x86_64-linux-gnu/libgcc_s.so.1
COPY --from=oracle-client /usr/lib/x86_64-linux-gnu/libaio.so.1t64 /usr/lib/x86_64-linux-gnu/libaio.so.1
COPY --from=oracle-client /opt/oracle /opt/oracle

# There is no ldconfig in the distroless image, so point the dynamic loader at the client directly.
ENV LD_LIBRARY_PATH=/opt/oracle/instantclient
