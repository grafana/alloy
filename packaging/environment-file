## Path:
## Description: Grafana Alloy settings
## Type:        string
## Default:     ""
## ServiceRestart: alloy
#
# Command line options for Alloy.
#
# The configuration file holding the Alloy Default Engine config.
CONFIG_FILE="/etc/alloy/config.alloy"

# The configuration file holding the Alloy OTel Engine config.
OTEL_CONFIG_FILE="/etc/alloy/config.yaml"

# User-defined arguments to pass to the default engine (`alloy run`). Has
# no effect when ALLOY_OTEL_MODE below is enabled; use CUSTOM_OTEL_ARGS
# instead.
CUSTOM_ARGS=""

# User-defined arguments to pass to the OTel engine (`alloy otel`). Only
# applies when ALLOY_OTEL_MODE below is enabled.
CUSTOM_OTEL_ARGS=""

# Set to (lowercase) 1, true, yes, or on to run the OTel engine (`alloy otel`)
# instead of the default engine (`alloy run`). Unset or any other value keeps
# the default engine.
ALLOY_OTEL_MODE=""

# Restart on system upgrade. Defaults to true.
RESTART_ON_UPGRADE=true
