invalid loki stages
-- main.alloy --
loki.process "valid" {
	forward_to = []

	stage.multiline {
		firstline = "^START"
	}

	stage.logfmt {
		regex = "^pod_"
	}

	stage.structured_metadata {
		regex = "^label_"
	}
}

loki.process "invalid_regex" {
	forward_to = []

	stage.logfmt {
		regex = "[unclosed"
	}

	stage.multiline {
		firstline = "[unclosed"
	}

	stage.structured_metadata {
		regex = "[unclosed"
	}
}
