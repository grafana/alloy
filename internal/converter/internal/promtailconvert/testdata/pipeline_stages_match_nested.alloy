discovery.kubernetes "example" {
	role            = "pod"
	kubeconfig_file = "/home/toby/.kube/config"

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + coalesce(sys.env("HOSTNAME"), constants.hostname)
	}
}

loki.process "example" {
	forward_to = [loki.write.default.receiver]

	stage.match {
		selector = "{app=\"one\"}"

		stage.docker { }

		stage.match {
			selector = "{app=\"two\"}"

			stage.cri { }
			action              = "keep"
			pipeline_name       = "two"
			drop_counter_reason = "nope_two"
		}
		action              = "keep"
		pipeline_name       = "one"
		drop_counter_reason = "nope"
	}

	stage.match {
		selector            = "{app=\"three\"}"
		action              = "drop"
		pipeline_name       = "three"
		drop_counter_reason = "nope_three"
	}
}

loki.source.file "example" {
	targets    = discovery.kubernetes.example.targets
	forward_to = [loki.process.example.receiver]

	file_match {
		enabled = true
	}
	legacy_positions_file = "/var/log/positions.yaml"
}

loki.write "default" {
	endpoint {
		url = "http://localhost/loki/api/v1/push"
	}
	external_labels = {}
}
