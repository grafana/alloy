otelcol.encoding.text "default_custom" {
	encoding               = "iso-8859-1"
	marshaling_separator   = " | "
	unmarshaling_separator = "\\s*\\|\\s*"
}

otelcol.encoding.jsonlog "default_custom" {
	array_mode = false
	mode       = "body_with_inline_attributes"
}

otelcol.encoding.azure "default" { }

otelcol.encoding.azure "default_custom" {
	logs {
		time_formats       = ["2006-01-02 15:04:05"]
		include_categories = ["FrontDoorAccessLog", "AzureCdnAccessLog"]
		exclude_categories = ["AzureCdnAccessLog"]
	}

	metrics {
		time_formats = ["01/02/2006 15:04:05"]
		aggregations = ["count", "total"]
	}

	traces {
		time_formats = ["2006-01-02T15:04:05Z"]
	}
}

otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "localhost:4317"
	}

	output {
		logs = [otelcol.exporter.debug.default.input]
	}
}

otelcol.exporter.debug "default" {
	verbosity = "Basic"
}
