SQL Server showplan XML with a Bitmap operator (parallel bitmap filtering),
which remains genuinely unmodeled. The node is Unknown, but the Table Scan
nested inside <Bitmap> is preserved as a child.

-- unmodeled_operator.xml --
<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan">
  <BatchSequence>
    <Batch>
      <Statements>
        <StmtSimple>
          <QueryPlan>
            <RelOp PhysicalOp="Bitmap" LogicalOp="Bitmap Create" EstimateRows="50" EstimatedTotalSubtreeCost="0.13">
              <Bitmap>
                <RelOp PhysicalOp="Table Scan" LogicalOp="Table Scan" EstimateRows="2000" EstimatedTotalSubtreeCost="0.1">
                  <TableScan>
                    <Object Database="[MyDb]" Schema="[dbo]" Table="[Orders]" />
                  </TableScan>
                </RelOp>
              </Bitmap>
            </RelOp>
          </QueryPlan>
        </StmtSimple>
      </Statements>
    </Batch>
  </BatchSequence>
</ShowPlanXML>
