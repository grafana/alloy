-- note --
/* select#1 */ select `t`.`customer_id` AS `customer_id`,`t`.`n` AS `n`,`shop`.`c`.`name` AS `name` from (/* select#2 */ select `shop`.`orders`.`customer_id` AS `customer_id`,count(0) AS `n` from `shop`.`orders` where (`shop`.`orders`.`note` = 'n') group by `shop`.`orders`.`customer_id`) `t` join `shop`.`customers` `c` where ((`t`.`customer_id` = `shop`.`c`.`id`) and (`shop`.`c`.`code` = 'x'))
