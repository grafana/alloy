{{define "marshalText"}}
{{- if .HasText}}

// marshalText returns the text form of an upstream value, whose type can be
// internal to its module.
func marshalText(m encoding.TextMarshaler) string {
	b, _ := m.MarshalText()
	return string(b)
}
